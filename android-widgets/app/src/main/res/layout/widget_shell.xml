<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/art" android:layout_width="match_parent"
  android:layout_height="match_parent" android:scaleType="fitXY"
  android:contentDescription="@string/app_name"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
  android:layout_gravity="bottom" android:orientation="horizontal">
  <FrameLayout android:id="@+id/resumeTap" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="1"/>
  <FrameLayout android:id="@+id/captureTap" android:layout_width="0dp"
   android:layout_height="match_parent" android:layout_weight="1"/>
 </LinearLayout>
</FrameLayout>
