<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/lb_cover">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/action_capture" android:orientation="vertical" android:layout_weight="1" android:paddingHorizontal="10dp" android:gravity="center_vertical" android:clickable="true" android:contentDescription="Capture a new note">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_weight="1" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="01 / JOT" android:textSize="10sp" android:textColor="#181916" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
            <ImageView android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/lb_nib" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_title" android:text="Field notes" android:textSize="21sp" android:textColor="#181916" android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture  +" android:textSize="12sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="5dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:id="@+id/action_open" android:orientation="horizontal" android:clickable="true" android:contentDescription="Open Lightbox Studio" android:background="@drawable/lb_foot" android:paddingHorizontal="10dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/widget_meta" android:text="0 notes" android:textSize="10sp" android:textColor="#B9A7FF" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open ↗" android:textSize="12sp" android:textColor="#FFFDF8" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
