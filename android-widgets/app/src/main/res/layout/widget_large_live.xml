<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/lb_leaf" android:paddingHorizontal="13dp" android:paddingVertical="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="21dp" android:layout_height="18dp" android:src="@drawable/lb_frame" android:importantForAccessibility="no" android:scaleType="fitCenter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="03  /  DIRECTOR’S DESK" android:textSize="10sp" android:textColor="#181916" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:layout_marginStart="6dp" />
        <TextView android:layout_width="49dp" android:layout_height="match_parent" android:text="Sync ↗" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/action_sync" android:gravity="center" android:clickable="true" android:contentDescription="Sync a story" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#181916" android:importantForAccessibility="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Director’s desk" android:textSize="25sp" android:textColor="#181916" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_title" android:layout_marginTop="5dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a story using Sync" android:textSize="12sp" android:textColor="#53564D" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_draft" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SCENE   —" android:textSize="10sp" android:textColor="#53564D" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_scene" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current scene" android:textSize="16sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_heading" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Progress" android:textSize="12sp" android:textColor="#53564D" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_count" />
        <ProgressBar android:layout_width="match_parent" android:layout_height="3dp" android:id="@+id/widget_progress" android:progressDrawable="@drawable/widget_progress_track" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:background="@drawable/lb_inset" android:paddingHorizontal="10dp" android:gravity="center_vertical" android:id="@+id/recent_area" android:clickable="true" android:contentDescription="Open saved notebook">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FIELD NOTES   ↗" android:textSize="10sp" android:textColor="#181916" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No saved notes" android:textSize="16sp" android:textColor="#181916" android:fontFamily="serif" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_recent" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manual story sync" android:textSize="10sp" android:textColor="#53564D" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_sync_status" android:layout_marginTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Studio ↗" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/action_open" android:layout_weight="1" android:gravity="center" android:clickable="true" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Note +" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/action_capture" android:layout_weight="1" android:gravity="center" android:clickable="true" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Start" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/action_session" android:layout_weight="1" android:gravity="center" android:clickable="true" android:background="@drawable/lb_ticket" />
    </LinearLayout>
</LinearLayout>
