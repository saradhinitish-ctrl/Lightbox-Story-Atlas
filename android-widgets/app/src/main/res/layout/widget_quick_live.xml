<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="11dp"
 android:background="@drawable/widget_panel_ink">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="LIGHTBOX  /  CAPTURE" android:textColor="#C6FF00"
  android:textSize="9sp" android:textStyle="bold" android:fontFamily="monospace"
  android:singleLine="true"/>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
  android:text="Your story" android:fontFamily="serif" android:textColor="#F5F3EB"
  android:textSize="22sp" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_meta" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginBottom="7dp"
  android:text="TAP + TO CAPTURE" android:textColor="#BBC0AE"
  android:textSize="8sp" android:fontFamily="monospace" android:singleLine="true"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
  android:orientation="horizontal">
  <TextView android:id="@+id/action_capture" android:layout_width="0dp" android:layout_weight="2"
   android:layout_height="match_parent" android:gravity="center"
   android:clickable="true" android:background="@drawable/widget_action_lime"
   android:text="NOTE +" android:textColor="#191B18" android:textSize="11sp"
   android:textStyle="bold" android:fontFamily="monospace"
   android:contentDescription="Capture a note in Lightbox"/>
  <TextView android:id="@+id/action_open" android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:layout_marginStart="6dp" android:gravity="center"
   android:clickable="true" android:background="@drawable/widget_soft_ink"
   android:text="OPEN" android:textColor="#F5F3EB" android:textSize="9sp"
   android:textStyle="bold" android:fontFamily="monospace"
   android:contentDescription="Open Lightbox studio"/>
 </LinearLayout>
</LinearLayout>
