<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="10dp" android:background="@drawable/widget_panel_paper">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="DIRECTOR’S DESK" android:textSize="11sp" android:textColor="#525A4F" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:text="Sync" android:textSize="14sp" android:textColor="#20231F" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:minWidth="48dp" android:gravity="center" android:clickable="true" android:contentDescription="Sync a story" android:id="@+id/action_sync" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No story linked" android:textSize="25sp" android:textColor="#20231F" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_title" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync a story to see its draft" android:textSize="12sp" android:textColor="#525A4F" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" android:id="@+id/widget_draft" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current scene" android:textSize="11sp" android:textColor="#525A4F" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_scene" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="#20231F" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" android:id="@+id/widget_heading" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#525A4F" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" android:id="@+id/widget_count" />
    <ProgressBar android:layout_width="match_parent" android:layout_height="3dp" android:id="@+id/widget_progress" android:progressDrawable="@drawable/widget_progress_track" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#C6C8BB" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical" android:clickable="true" android:id="@+id/recent_area" android:contentDescription="Open saved notebook">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LAST NOTE" android:textSize="11sp" android:textColor="#525A4F" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No saved notes" android:textSize="16sp" android:textColor="#20231F" android:fontFamily="serif" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp" android:id="@+id/widget_recent" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manual sync" android:textSize="11sp" android:textColor="#525A4F" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_sync_status" />
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#C6C8BB" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Studio" android:textSize="14sp" android:textColor="#20231F" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_open" />
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Note +" android:textSize="14sp" android:textColor="#20231F" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_capture" />
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Start" android:textSize="14sp" android:textColor="#20231F" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_session" />
  </LinearLayout>
</LinearLayout>
