<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="17dp"
 android:background="@drawable/widget_panel_ink">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="wrap_content" android:text="LIGHTBOX  /  DIRECTOR DESK"
   android:fontFamily="monospace" android:textColor="#C6FF00"
   android:textSize="10sp" android:textStyle="bold" android:singleLine="true"/>
  <TextView android:id="@+id/widget_session" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:text="READY"
   android:fontFamily="monospace" android:textColor="#B5C1A7"
   android:textSize="10sp" android:textStyle="bold"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="16dp"
  android:fontFamily="serif" android:text="Your film." android:textColor="#F5F3EB"
  android:textSize="32sp" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_draft" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="4dp"
  android:fontFamily="monospace" android:text="CURRENT DRAFT"
  android:textColor="#A8B09D" android:textSize="9sp" android:singleLine="true"/>
 <TextView android:id="@+id/widget_scene" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="17dp"
  android:fontFamily="monospace" android:text="SCENE --"
  android:textColor="#C6FF00" android:textSize="11sp"
  android:textStyle="bold" android:singleLine="true"/>
 <TextView android:id="@+id/widget_heading" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1" android:gravity="top"
  android:layout_marginTop="6dp" android:text="Your next scene begins here."
  android:textColor="#F5F3EB" android:textSize="16sp" android:fontFamily="serif"
  android:maxLines="3" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_count" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:fontFamily="monospace"
  android:text="NO STORY SYNCED" android:textColor="#B5C1A7" android:textSize="10sp"/>
 <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
  android:layout_width="match_parent" android:layout_height="4dp"
  android:layout_marginTop="8dp" android:max="100" android:progress="0"
  android:progressDrawable="@drawable/widget_progress_track"/>
 <TextView android:id="@+id/widget_recent" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="12dp"
  android:background="@drawable/widget_soft_ink" android:padding="11dp"
  android:text="NEW IDEA? TAP NOTE + TO CAPTURE."
  android:textColor="#E5E6D9" android:textSize="11sp" android:maxLines="2"
  android:ellipsize="end" android:clickable="true"
  android:contentDescription="Open your captured notes"/>
 <TextView android:id="@+id/widget_sync_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="12dp"
  android:fontFamily="monospace" android:text="SYNC A STORY TO BEGIN"
  android:textColor="#A8B09D" android:textSize="9sp" android:maxLines="1"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
  android:layout_marginTop="12dp" android:orientation="horizontal">
  <TextView android:id="@+id/action_open" android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:gravity="center" android:clickable="true"
   android:background="@drawable/widget_action_lime" android:text="WRITE ↗"
   android:textColor="#191B18" android:textSize="10sp" android:textStyle="bold"
   android:contentDescription="Open Lightbox studio"/>
  <TextView android:id="@+id/action_capture" android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center"
   android:clickable="true" android:background="@drawable/widget_soft_ink"
   android:text="NOTE +" android:textColor="#F5F3EB" android:textSize="10sp"
   android:textStyle="bold" android:contentDescription="Capture a new note"/>
  <TextView android:id="@+id/action_session" android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center"
   android:clickable="true" android:background="@drawable/widget_soft_ink"
   android:text="START" android:textColor="#F5F3EB" android:textSize="10sp"
   android:textStyle="bold" android:contentDescription="Start or finish session"/>
  <TextView android:id="@+id/action_sync" android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center"
   android:clickable="true" android:background="@drawable/widget_soft_ink"
   android:text="SYNC ↗" android:textColor="#F5F3EB" android:textSize="10sp"
   android:textStyle="bold" android:contentDescription="Open story synchronization"/>
 </LinearLayout>
</LinearLayout>
