<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/lb_leaf">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/lb_mast" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="9dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03 / DIRECTOR’S DESK" android:textSize="10sp" android:textColor="#B9A7FF" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_title" android:text="Director’s desk" android:textSize="24sp" android:textColor="#FFFDF8" android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_draft" android:text="Choose a story using Sync" android:textSize="12sp" android:textColor="#E0DED6" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:layout_width="56dp" android:layout_height="48dp" android:src="@drawable/lb_reels" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical" android:paddingHorizontal="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/widget_scene" android:text="SCENE   —" android:textSize="10sp" android:textColor="#53564D" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
            <TextView android:layout_width="54dp" android:layout_height="40dp" android:id="@+id/action_sync" android:text="Sync ↗" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:clickable="true" android:contentDescription="Sync a story" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_heading" android:text="Current scene" android:textSize="17sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_count" android:text="Writing progress" android:textSize="12sp" android:textColor="#53564D" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:layout_width="match_parent" android:layout_height="4dp" android:id="@+id/widget_progress" android:progressDrawable="@drawable/widget_progress_track" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/recent_area" android:orientation="vertical" android:layout_weight="0.84" android:layout_marginHorizontal="8dp" android:layout_marginVertical="4dp" android:paddingHorizontal="11dp" android:gravity="center_vertical" android:background="@drawable/lb_inset" android:clickable="true" android:contentDescription="Open saved notebook">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOTEBOOK   ↗" android:textSize="10sp" android:textColor="#181916" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_recent" android:text="No saved notes" android:textSize="17sp" android:textColor="#181916" android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_sync_status" android:text="Manual story sync" android:textSize="10sp" android:textColor="#53564D" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="14dp" android:layout_marginBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/lb_foot" android:paddingHorizontal="5dp" android:paddingVertical="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/action_open" android:text="Studio ↗" android:textSize="13sp" android:textColor="#FFFDF8" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:clickable="true" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/action_capture" android:text="Note +" android:textSize="13sp" android:textColor="#FFFDF8" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:clickable="true" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:id="@+id/action_session" android:text="Start" android:textSize="13sp" android:textColor="#181916" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:clickable="true" android:background="@drawable/lb_ticket" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
