<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_panel_ink" android:paddingHorizontal="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_weight="1" android:gravity="center_vertical">
    <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:text="—" android:textSize="25sp" android:textColor="#D3F37C" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_scene" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scene desk" android:textSize="21sp" android:textColor="#F4F1E8" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:id="@+id/widget_title" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Story not synced" android:textSize="12sp" android:textColor="#BCC6B6" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp" android:id="@+id/widget_count" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#535B50" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Studio" android:textSize="14sp" android:textColor="#F4F1E8" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_open" />
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Note +" android:textSize="14sp" android:textColor="#F4F1E8" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_capture" />
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:text="Start" android:textSize="14sp" android:textColor="#F4F1E8" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:clickable="true" android:id="@+id/action_session" />
  </LinearLayout>
</LinearLayout>
